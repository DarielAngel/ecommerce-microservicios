# URL del Gateway (no del servicio directamente — todo pasa por el Gateway)
VITE_API_BASE_URL=http://localhost:5000

# Clave fija que protege el acceso a esta pantalla de login (NO es la autenticación
# real de la API — eso sigue siendo JWT + rol Admin vía Users). Cambiala en produccion.
VITE_ADMIN_SITE_KEY=clave-panel-de-desarrollo
