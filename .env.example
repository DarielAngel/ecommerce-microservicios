# Copia este archivo a ".env" (sin el ".example") en la raíz del repo, y completa los
# valores que necesites. Docker Compose lee ".env" automáticamente — no hace falta correr
# ningún "set" en cmd.exe antes de "docker compose up", y el valor persiste entre sesiones
# y entre terminales distintas, a diferencia de "set" (que solo dura mientras esa ventana
# de cmd siga abierta). El archivo ".env" real NUNCA se commitea (está en .gitignore).

# Módulo 2 (Users): clave para crear cuentas Admin vía POST /api/admins.
# Si la dejas vacía, se usa el valor por defecto del docker-compose.yml.
ADMIN_PROVISIONING_KEY=clave-admin-de-desarrollo

# Módulo 9 (Panel de Admin): clave que protege la pantalla de login del panel.
ADMIN_PANEL_SITE_KEY=clave-panel-de-desarrollo

# Secreto para firmar los JWT (compartido entre todos los microservicios).
JWT_SECRET=clave-de-desarrollo-cambiar-en-produccion-1234567890

# Módulo 6/7 (Pagos): credenciales reales de tu app de sandbox en developer.paypal.com.
# Déjalas vacías si no tienes acceso a PayPal — el checkout va a fallar con 502 al crear
# el pago, que es el comportamiento esperado documentado en el README.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Alternativa a lo de arriba: "Fake" simula PayPal completo (pagos siempre exitosos, sin
# credenciales) para poder probar el flujo de checkout de punta a punta. "Real" (o vacío)
# usa el PayPal real de verdad. Ver la sección "Probar el checkout completo sin PayPal
# real" del README.
PAYPAL_PROVIDER=Real

# Módulo 8 (Notificaciones): tu API key real de resend.com (empieza con "re_").
# Sin esto, el envío de emails falla con un error claro en los logs — el resto del
# sistema funciona igual.
RESEND_API_KEY=
RESEND_FROM_ADDRESS=onboarding@resend.dev
