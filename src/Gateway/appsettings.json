{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "users-auth-route": {
        "ClusterId": "users-cluster",
        "Match": {
          "Path": "/api/auth/{**catch-all}"
        }
      },
      "users-admins-route": {
        "ClusterId": "users-cluster",
        "Match": {
          "Path": "/api/admins/{**catch-all}"
        }
      },
      "users-addresses-route": {
        "ClusterId": "users-cluster",
        "Match": {
          "Path": "/api/addresses/{**catch-all}"
        }
      },
      "catalog-products-route": {
        "ClusterId": "catalog-cluster",
        "Match": {
          "Path": "/api/products/{**catch-all}"
        }
      },
      "catalog-categories-route": {
        "ClusterId": "catalog-cluster",
        "Match": {
          "Path": "/api/categories/{**catch-all}"
        }
      },
      "catalog-images-route": {
        "ClusterId": "catalog-cluster",
        "Match": {
          "Path": "/images/{**catch-all}"
        }
      },
      "inventory-stock-route": {
        "ClusterId": "inventory-cluster",
        "Match": {
          "Path": "/api/stock/{**catch-all}"
        }
      },
      "cart-route": {
        "ClusterId": "cart-cluster",
        "Match": {
          "Path": "/api/cart/{**catch-all}"
        }
      },
      "payments-route": {
        "ClusterId": "payments-cluster",
        "Match": {
          "Path": "/api/payments/{**catch-all}"
        }
      },
      "orders-route": {
        "ClusterId": "orders-cluster",
        "Match": {
          "Path": "/api/orders/{**catch-all}"
        }
      },
      "notifications-route": {
        "ClusterId": "notifications-cluster",
        "Match": {
          "Path": "/api/notifications/{**catch-all}"
        }
      },
      "reviews-route": {
        "ClusterId": "reviews-cluster",
        "Match": {
          "Path": "/api/reviews/{**catch-all}"
        }
      },
      "wishlist-route": {
        "ClusterId": "wishlist-cluster",
        "Match": {
          "Path": "/api/wishlist/{**catch-all}"
        }
      },
      "coupons-route": {
        "ClusterId": "promotions-cluster",
        "Match": {
          "Path": "/api/coupons/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "users-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://users-service:8080/"
          }
        }
      },
      "catalog-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://catalog-service:8080/"
          }
        }
      },
      "inventory-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://inventory-service:8080/"
          }
        }
      },
      "cart-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://cart-service:8080/"
          }
        }
      },
      "payments-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://payments-service:8080/"
          }
        }
      },
      "orders-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://orders-service:8080/"
          }
        }
      },
      "notifications-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://notifications-service:8080/"
          }
        }
      },
      "reviews-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://reviews-service:8080/"
          }
        }
      },
      "wishlist-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://wishlist-service:8080/"
          }
        }
      },
      "promotions-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://promotions-service:8080/"
          }
        }
      }
    }
  }
}
